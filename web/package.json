{
  "name": "eidolon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/check-copy.mjs && node scripts/check-credits.mjs",
    "check:credits": "node scripts/check-credits.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run --passWithNoTests",
    "test:live": "vitest run --mode live --testTimeout=90000 src/data/live.test.ts",
    "typecheck": "tsc --noEmit",
    "types": "node scripts/gen-types.mjs",
    "capture": "node scripts/capture.mjs --target=build",
    "capture:ref": "node scripts/capture.mjs --target=reference",
    "fetch:real": "node scripts/fetch-real-data.mjs",
    "fetch:surface": "node scripts/fetch-surface.mjs",
    "perf": "vite build && node scripts/perf.mjs",
    "a11y": "node scripts/a11y.mjs",
    "poster": "node scripts/capture.mjs --target=build --states=title-shot && node scripts/capture.mjs --target=build --states=og --viewports=og && node scripts/poster.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/three": "^0.186.0",
    "ajv": "^8.20.0",
    "geotiff": "^3.0.5",
    "json-schema-to-typescript": "^16.0.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
